
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1">
  <title>Location Prank</title>
  <style>
    body {
      background: #101827;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 60px 20px;
    }
    .card {
      max-width: 420px;
      margin: auto;
      padding: 30px;
      background: #1e293b;
      border-radius: 18px;
    }
    button {
      background: #22c55e;
      color: white;
      border: none;
      padding: 15px 25px;
      border-radius: 10px;
      font-size: 17px;
      cursor: pointer;
    }
    #result {
      margin-top: 25px;
      font-size: 20px;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>📍 Location Scanner</h1>
    <p>Can we guess where you are?</p>
    <button onclick="startPrank()">
      Find My Location
    </button>
    <div id="result"></div>
  </div>

  <script>
    function startPrank() {
      const result =
        document.getElementById("result");

      result.textContent = "Scanning...";

      setTimeout(() => {
        result.textContent =
          "Locating your device...";
      }, 1500);

      setTimeout(() => {
        result.innerHTML =
          "😂 GOT YOU!<br>" +
          "This was just a prank!<br>" +
          "Your real location was never accessed.";
      }, 3500);
    }
  </script>
</body>
</html>
